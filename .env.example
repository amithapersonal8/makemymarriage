# Public pages and production builds work without database credentials.
# Copy to .env.local and set your development database connection for account access.
# Use a dedicated non-production database. Never commit real secrets.
MONGODB_URI=
# Exact browser origin allowed for signup, login, and logout (no trailing path).
# Set the HTTPS application origin explicitly in production and preview environments.
APP_ORIGIN=http://127.0.0.1:3000
# Only browser-safe values may use the NEXT_PUBLIC_ prefix.
